{
  "name": "pubg-map-overlay",
  "version": "0.1.0",
  "description": "Discord-style always-on-top overlay window for pubg.adz.pm",
  "author": "adzpm",
  "main": "src/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win --x64 --publish never"
  },
  "build": {
    "appId": "pm.adz.pubg-map.overlay",
    "productName": "PUBG Map Overlay",
    "artifactName": "pubg-map-overlay-${version}-${arch}.${ext}",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "portable": {
      "artifactName": "pubg-map-overlay-${version}-${arch}-portable.${ext}"
    }
  },
  "devDependencies": {
    "electron": "44.1.0",
    "electron-builder": "26.15.3"
  }
}
