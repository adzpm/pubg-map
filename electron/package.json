{
  "name": "pubg-map-overlay",
  "private": true,
  "version": "0.1.0",
  "description": "Transparent always-on-top Electron overlay that loads the pubg-map web app",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "start:prod": "PUBG_MAP_URL=http://localhost:8080 electron .",
    "build:win": "electron-builder --win --x64",
    "build:win:portable": "electron-builder --win portable --x64"
  },
  "devDependencies": {
    "electron": "^32.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.adzpm.pubg-map-overlay",
    "productName": "PUBG Map Overlay",
    "files": [
      "main.js",
      "preload.js",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false
    },
    "directories": {
      "output": "dist"
    }
  }
}
